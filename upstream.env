# Single source of truth for what Mattermore builds from.
#
# Bumping a tag here is how upstream security fixes are picked up. Each patch
# series in patches/ is applied to a clean checkout of the matching tag, so
# there is never a merge to resolve, only a patch that may need rebasing.

# Mattermost server. Patches in patches/server/.
SERVER_TAG=v12.0.1
SERVER_COMMIT=987e57120dca630dadbcd2638064ab66a02bb81e

# Calls plugin. Patches in patches/calls/.
CALLS_TAG=v1.12.6
CALLS_COMMIT=b8a43a461f6a15ebd5229d08098a34b71f659b3c

# Call transcriber. Patches in patches/transcriber/.
TRANSCRIBER_TAG=master

# Mattermore's own plugin version.
#
# This MUST stay above anything Mattermost ships prepackaged, or a server
# upgrade replaces Mattermore with official Calls. The server only overwrites
# an installed plugin when the prepackaged copy has a strictly higher version
# (server/channels/app/plugin.go, shouldPersistTransitionallyPrepackagedPlugin).
#
# Convention: 1000.<upstream>. Upstream v1.12.5 becomes 1000.12.5.
CALLS_VERSION=1000.12.6
